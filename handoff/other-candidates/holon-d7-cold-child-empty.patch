+#[tokio::test]
+async fn actual_fresh_cold_child_without_state_requires_complete_empty_source_and_keeps_actual_material(
+) -> Result<()> {
+    use crate::runtime::input_evidence_budget::{InputMemoryCategory, OwnedBytesEstimate};
+    use crate::runtime::resident_input_evidence::InputEvidenceScope;
+    use crate::runtime_db::cold_child_domains::prepare_empty_cold_child_tx;
+    let (_home, host, parent) = host_backed_test_runtime().await;
+    let identity = add_child(&host, &parent, false).await?;
+    assert!(host
+        .try_get_loaded_runtime(&identity.agent_id)
+        .await
+        .is_none());
+    assert!(host
+        .runtime_db()
+        .agent_states()
+        .latest(&identity.agent_id)?
+        .is_none());
+    parent.refresh_context_resources().await?;
+    parent.quiesce_child_summary_observer_for_test().await?;
+    let owner = parent.reserve_original_task_input_owner_for_test().await?;
+    let root = owner.capture_ready_snapshot()?.unwrap();
+    let strong = Arc::strong_count(&root);
+    let scope = InputEvidenceScope {
+        agent_id: identity.agent_id.clone(),
+        identity_incarnation: identity.incarnation,
+    };
+    let ledger = &host.inner.input_evidence_budget;
+    let baseline = ledger.report()?.observed_bytes;
+    let held = vec![17u8; 128 * 1024];
+    let prior_guard = ledger.register_owned_bytes(
+        &scope,
+        InputMemoryCategory::Pins,
+        OwnedBytesEstimate {
+            payload_bytes: held.len() as u64,
+            metadata_estimate_bytes: 256,
+        },
+    )?;
+    let prior = (prior_guard.owned_material_bytes()?, 1);
+    let held_baseline = ledger.report()?.observed_bytes;
+    let capture = |limits| {
+        host.runtime_db().transaction(|tx| {
+            prepare_empty_cold_child_tx(tx, &scope, &identity, ledger, limits, prior)
+        })
+    };
+    let source = capture(LIMITS)?;
+    assert_eq!(source.identity(), &identity);
+    assert!(source.material_estimate()?.0 > 0);
+    let weak = Arc::downgrade(source.first_guard_for_test());
+    let foreign = InputEvidenceBudgetLedger::new(ledger.limits())?;
+    assert!(source.validate_accounting(&scope, &foreign).is_err());
+    assert_eq!(Arc::strong_count(&root), strong);
+    assert!(Arc::ptr_eq(
+        &root,
+        &owner.capture_ready_snapshot()?.unwrap()
+    ));
+    drop(source);
+    assert!(weak.upgrade().is_none());
+    assert_eq!(ledger.report()?.observed_bytes, held_baseline);
+    let mut nodes = (prior.1, LIMITS.1);
+    while nodes.0 + 1 < nodes.1 {
+        let middle = nodes.0 + (nodes.1 - nodes.0) / 2;
+        match capture((LIMITS.0, middle)) {
+            Ok(source) => {
+                drop(source);
+                nodes.1 = middle;
+            }
+            Err(error) => {
+                assert!(empty_source_exhausted(&error), "{error:#}");
+                nodes.0 = middle;
+            }
+        }
+        assert_eq!(ledger.report()?.observed_bytes, held_baseline);
+    }
+    let mut bytes = (usize::try_from(prior.0)?, LIMITS.0);
+    while bytes.0 + 1 < bytes.1 {
+        let middle = bytes.0 + (bytes.1 - bytes.0) / 2;
+        match capture((middle, nodes.1)) {
+            Ok(source) => {
+                drop(source);
+                bytes.1 = middle;
+            }
+            Err(error) => {
+                assert!(empty_source_exhausted(&error), "{error:#}");
+                bytes.0 = middle;
+            }
+        }
+        assert_eq!(ledger.report()?.observed_bytes, held_baseline);
+    }
+    assert!(empty_source_exhausted(
+        &capture((bytes.1 - 1, nodes.1))
+            .err()
+            .context("byte-minus-one must reject")?
+    ));
+    assert!(empty_source_exhausted(
+        &capture((bytes.1, nodes.1 - 1))
+            .err()
+            .context("node-minus-one must reject")?
+    ));
+    let exact = capture((bytes.1, nodes.1))?;
+    let last = Arc::downgrade(exact.first_guard_for_test());
+    assert!(last.upgrade().is_some());
+    drop(exact);
+    assert!(last.upgrade().is_none());
+    assert_eq!(ledger.report()?.observed_bytes, held_baseline);
+    assert!(host
+        .runtime_db()
+        .agent_states()
+        .latest(&identity.agent_id)?
+        .is_none());
+    assert!(host
+        .try_get_loaded_runtime(&identity.agent_id)
+        .await
+        .is_none());
+    assert!(Arc::ptr_eq(
+        &root,
+        &owner.capture_ready_snapshot()?.unwrap()
+    ));
+    drop((prior_guard, held));
+    assert_eq!(ledger.report()?.observed_bytes, baseline);
+    Ok(())
+}
+
+fn empty_source_exhausted(error: &anyhow::Error) -> bool {
+    use crate::runtime_db::{
+        cold_child_domains::ColdChildReadError,
+        input_evidence_snapshot::InputEvidenceSnapshotError,
+        scheduling_snapshot::SchedulingSnapshotError,
+    };
+    matches!(
+        error.downcast_ref::<ColdChildReadError>(),
+        Some(ColdChildReadError::ResourceExhausted)
+    ) || matches!(
+        error.downcast_ref::<InputEvidenceSnapshotError>(),
+        Some(InputEvidenceSnapshotError::ResourceExhausted(_))
+    ) || matches!(
+        error.downcast_ref::<SchedulingSnapshotError>(),
+        Some(SchedulingSnapshotError::ResourceExhausted(_))
+    )
+}
