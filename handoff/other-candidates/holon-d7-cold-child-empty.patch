+//! A missing State is displayable only with the original complete empty proof.
+use super::{
+    phase_limits, selector, ColdChildReadError, InputEvidenceBudgetLedger, InputEvidenceScope,
+    InputReadMaterial,
+};
+use crate::{
+    runtime::input_evidence_budget::BudgetViewGuard,
+    runtime_db::{
+        input_evidence_snapshot::InputEvidenceLoadRequest,
+        scheduling_snapshot::{
+            prepare_cold_scheduling_query_with_identity_tx, ColdSchedulingQuery,
+            SchedulingDomainLoadRequest,
+        },
+    },
+    types::{AgentIdentityRecord, AgentKind, AgentRegistryStatus},
+};
+use anyhow::{ensure, Context, Result};
+use rusqlite::{params, Transaction};
+use std::{collections::BTreeSet, sync::Arc};
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum EmptyColdChildError {
+    #[error("cold child has no complete original empty source")]
+    Incomplete,
+}
+
+/// Only this actor can construct the proof. Identity and its actual material
+/// remain together; no State, Root, database handle or business grant is stored.
+pub(crate) struct ProvenEmptyColdChild {
+    identity: AgentIdentityRecord,
+    scope: InputEvidenceScope,
+    ledger: InputEvidenceBudgetLedger,
+    own: (u64, usize),
+    guards: Vec<Arc<BudgetViewGuard>>,
+}
+impl ProvenEmptyColdChild {
+    pub(crate) fn identity(&self) -> &AgentIdentityRecord {
+        &self.identity
+    }
+    pub(crate) fn validate_accounting(
+        &self,
+        scope: &InputEvidenceScope,
+        ledger: &InputEvidenceBudgetLedger,
+    ) -> Result<()> {
+        ensure!(
+            self.scope == *scope
+                && self.ledger.same_ledger(ledger)
+                && self.identity.agent_id == scope.agent_id
+                && self.identity.incarnation == scope.identity_incarnation
+                && self.identity.status == AgentRegistryStatus::Active
+                && self.identity.kind == AgentKind::Child
+                && self.identity.parent_agent_id.is_some()
+                && !self.guards.is_empty(),
+            ColdChildReadError::ForeignMaterial
+        );
+        for guard in &self.guards {
+            guard
+                .validate_owned_material_binding(scope, ledger, 0)
+                .context(ColdChildReadError::ForeignMaterial)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn material_estimate(&self) -> Result<(u64, usize)> {
+        self.validate_accounting(&self.scope, &self.ledger)?;
+        Ok(self.own)
+    }
+    #[cfg(test)]
+    pub(crate) fn first_guard_for_test(&self) -> &Arc<BudgetViewGuard> {
+        &self.guards[0]
+    }
+}
+
+// Only normalized ownership/membership scalars are inspected. A raw late body,
+// a tombstone or an old fixed member cannot turn into an empty current view.
+// Table absence is an error, never evidence of complete empty observation.
+const COMPLETE_EMPTY: &str = "SELECT
+ EXISTS(SELECT 1 FROM agent_episode_continuity WHERE agent_id=?1 AND identity_incarnation=?2 AND policy_version=1 AND mode='fresh_empty' AND seed_id IS NULL)
+ AND NOT EXISTS(SELECT 1 FROM tasks WHERE owner_agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM task_result_settlements WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM work_items WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM wait_conditions WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM work_item_continuations WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM messages WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM queue_entries WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM briefs WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM delivery_summaries WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM transcript_entries WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM tool_executions WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM turn_records WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM audit_events WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM execution_protocol_partitions WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM execution_protocol_work_items WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM execution_protocol_attempts WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM execution_protocol_outcomes WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM execution_protocol_command_results WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM task_domain_current WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM task_domain_records WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM task_domain_import_inventory WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM task_message_sources WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM task_message_order_headers WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM task_query_task_members WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM task_query_task_births WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM work_domain_current WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM work_domain_records WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM work_domain_result_heads WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM work_domain_wait_edges WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM current_read_current WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM current_read_members WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM current_read_fixed_members WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM current_read_import_inventory WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM current_event_native_births WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_evidence_current WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_evidence_execution_current_sources WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_evidence_execution_current_work WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_query_birth_members WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_legacy_delivery_current_sources WHERE agent_id=?1 AND identity_incarnation=?2)
+ AND NOT EXISTS(SELECT 1 FROM input_legacy_delivery_fixed_members WHERE agent_id=?1)
+ AND NOT EXISTS(SELECT 1 FROM episode_continuity_seeds WHERE agent_id=?1)";
+
+/// Explicit cold inspection under the caller's already-held child reservation.
+/// Fresh original emptiness does not create canonical State or a ready domain.
+/// Legacy complete-empty facets need their own full observed-table proof; this
+/// actor does not borrow fresh semantics for an unbound/legacy namespace.
+pub(crate) fn prepare_empty_cold_child_tx(
+    tx: &Transaction<'_>,
+    scope: &InputEvidenceScope,
+    expected: &AgentIdentityRecord,
+    ledger: &InputEvidenceBudgetLedger,
+    requested: (usize, usize),
+    caller_prior: (u64, usize),
+) -> Result<ProvenEmptyColdChild> {
+    let limits = phase_limits(ledger, requested)?;
+    let prior = (usize::try_from(caller_prior.0)?, caller_prior.1);
+    let remaining = (
+        limits
+            .0
+            .checked_sub(prior.0)
+            .context(ColdChildReadError::ResourceExhausted)?,
+        limits
+            .1
+            .checked_sub(prior.1)
+            .context(ColdChildReadError::ResourceExhausted)?,
+    );
+    let query = prepare_cold_scheduling_query_with_identity_tx(
+        tx,
+        scope,
+        &SchedulingDomainLoadRequest {
+            capture: crate::runtime::resident_scheduling::SchedulingCaptureRequest::current(),
+            byte_limit: remaining.0,
+            record_limit: remaining.1,
+        },
+        ledger,
+        |identity, has_state| {
+            ensure!(
+                identity.agent_id == expected.agent_id
+                    && identity.incarnation == expected.incarnation
+                    && identity.kind == expected.kind
+                    && identity.parent_agent_id == expected.parent_agent_id
+                    && identity.kind == AgentKind::Child
+                    && identity.parent_agent_id.is_some()
+                    && expected.status == AgentRegistryStatus::Active,
+                ColdChildReadError::ForeignMaterial
+            );
+            ensure!(!has_state, ColdChildReadError::StateUnavailable);
+            Ok(())
+        },
+    )?;
+    let ColdSchedulingQuery::ProvenEmptyNoState {
+        identity,
+        material_usage,
+        mut guards,
+    } = query
+    else {
+        return Err(ColdChildReadError::StateUnavailable.into());
+    };
+    let admitted = (
+        prior
+            .0
+            .checked_add(material_usage.0)
+            .context(ColdChildReadError::ResourceExhausted)?,
+        prior
+            .1
+            .checked_add(material_usage.1)
+            .context(ColdChildReadError::ResourceExhausted)?,
+    );
+    let request = InputEvidenceLoadRequest {
+        windows: Vec::new(),
+        mandatory_roots: BTreeSet::new(),
+        interrupted_sources: BTreeSet::new(),
+        selected_completion_brief_ids: BTreeSet::new(),
+        byte_limit: limits.0,
+        record_limit: limits.1,
+    };
+    let mut material = InputReadMaterial::new(scope, &request, ledger, admitted)?;
+    material.validate_accounting(scope, ledger)?;
+    // Admit the source's scope, keeper Vec and scalar-proof headers first.
+    selector(&mut material, scope)?;
+    let complete: bool = tx.query_row(
+        COMPLETE_EMPTY,
+        params![scope.agent_id, scope.identity_incarnation],
+        |row| row.get(0),
+    )?;
+    ensure!(complete, EmptyColdChildError::Incomplete);
+    let usage = material.usage();
+    let own = (
+        u64::try_from(
+            usage
+                .0
+                .checked_sub(prior.0)
+                .context(ColdChildReadError::ResourceExhausted)?,
+        )?,
+        usage
+            .1
+            .checked_sub(prior.1)
+            .context(ColdChildReadError::ResourceExhausted)?,
+    );
+    guards.extend(material.into_guards());
+    let source = ProvenEmptyColdChild {
+        identity,
+        scope: scope.clone(),
+        ledger: ledger.clone(),
+        own,
+        guards,
