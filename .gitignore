dist/
web-gui/app/dist-e2e/
# web-gui/app/dist stays tracked via .gitkeep: rust-embed requires the
# directory to exist, and `cargo publish` verification rejects build.rs
# creating it inside the packaged source tree.
!web-gui/app/dist/
web-gui/app/dist/*
!web-gui/app/dist/.gitkeep
build/
coverage/
.DS_Store
# Intentional DMG volume layout asset, see scripts/create-macos-dmg.sh.
!apps/macos/dmg-layout/.DS_Store
target/
web-gui/app/playwright-report/
web-gui/app/test-results/
/bin/
_testwork/
__pycache__/
*.pyc

